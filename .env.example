NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_MAPS_API_KEY=

# --- Mail (SMTP) ---
# Gmail: use an App Password, not the account password (Google Account > Security > App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER if unset
SMTP_FROM=

# --- RFQ pipeline ---
# Mailbox that receives new RFQ decision mails (Accept/Reject buttons)
RFQ_NOTIFY_EMAIL=mahavirvalves@gmail.com

# --- Admin portal ---
# Comma-separated list of emails allowed to sign in to /admin
ADMIN_EMAILS=pushkarj32@gmail.com,mahavirvalves@gmail.com

# --- Signing secret for RFQ decision links & admin sessions ---
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Google Sheets sync (RFQ ledger + confirmed orders) ---
# Service account JSON key from Google Cloud Console, sheet shared with the
# service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# --- Expiry cron (vercel.json hits this hourly) ---
# Generate one with: openssl rand -base64 32
CRON_SECRET=
